{"$id":"EP1v8jIBloNuOHRz9j3BlFwpHkI_iGLkyC6UJAwjt-Yk","$schema":"http://json-schema.org/draft-07/schema#","title":"dzq Certificate","description":"A signed promise from the issuer to whoever meets its condition. What is promised, a note and the look are in a salted block. No use counter; the issuer may close it early.","type":"object","credentialType":"DzqCertificate","version":"1.1.0","properties":{"v":{"type":"string"},"d":{"type":"string"},"i":{"type":"string"},"ri":{"type":"string"},"s":{"type":"string"},"a":{"type":"object","properties":{"d":{"type":"string"},"i":{"type":"string","description":"Recipient AID"},"dt":{"type":"string","format":"date-time"},"until":{"type":"string","format":"date-time"},"c":{"oneOf":[{"type":"string","description":"Compact form: the SAID of the content block"},{"type":"object","properties":{"d":{"type":"string"},"u":{"type":"string","description":"Salt: 128 random bits, CESR qb64 (0A…)"},"what":{"type":"string","maxLength":200},"note":{"type":"string","maxLength":5000},"look":{"type":"string","pattern":"^[a-z0-9-]+:[^\\s]+$","description":"<source>:<id> — where to ask, and the SAID (or a name) of the look/1 document"}},"required":["d","u","what"],"additionalProperties":false}]}},"required":["d","i","dt","c"],"additionalProperties":false}},"required":["v","d","i","ri","s","a"],"additionalProperties":false}